{
  "name": "jigerpg-2024",
  "version": "2.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/host.mjs",
    "start:local": "node scripts/host.mjs --local",
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch scripts/dev-server.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*",
    "test:e2e": "node --import tsx --test tests/client-ui.test.ts tests/client-live.test.ts",
    "coverage:rules": "node scripts/report-coverage.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@koa/bodyparser": "6.1.0",
    "@koa/router": "15.7.1",
    "better-sqlite3": "13.0.3",
    "koa": "3.3.0",
    "pixi.js": "8.22.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/koa": "3.0.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
